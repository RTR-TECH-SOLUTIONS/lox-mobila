---
import { Image } from 'astro:assets';
import SpecList from './ui/SpecList.astro';
import SectionHeading from './ui/SectionHeading.astro';
import { resolveImage } from '../lib/images';
import { buildLightboxImages, projectAlt } from '../lib/lightbox-images';
import type { Project } from '../data/types';

interface Props {
  projects: Project[];
  /** cate proiecte exista in total, pentru panoul de final */
  total: number;
}

const { projects, total } = Astro.props;

const pad = (n: number) => String(n).padStart(2, '0');

const panels = await Promise.all(
  projects.map(async (project) => ({
    project,
    alt: projectAlt(project),
    cover: resolveImage('projects', project.cover),
    lightbox: await buildLightboxImages(project),
  })),
);
---

<!--
  Galerie orizontala fixata: pe desktop, scroll-ul vertical impinge panourile pe orizontala
  (scripts/showcase.ts adauga .is-pinned). Fara JS, pe mobil sau cu miscare redusa ramane
  un carusel nativ cu scroll-snap.
-->
<section class="showcase" data-showcase aria-labelledby="proiecte-title">
  <div class="showcase__sticky">
    <div class="wrap">
      <SectionHeading
        n="III"
        title="Proiecte"
        id="proiecte-title"
        more={{ href: '/proiecte', label: `Toate cele ${total} proiecte` }}
      >
        <div class="showcase__meta" slot="aside">
          <span class="showcase__count tabular-nums" aria-hidden="true">
            <span data-sc-current>01</span> / {pad(panels.length)}
          </span>
          <div class="showcase__arrows">
            <button type="button" class="showcase__arrow" data-sc-prev aria-label="Proiectul anterior">
              <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3 5 8l5 5" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
            </button>
            <button type="button" class="showcase__arrow" data-sc-next aria-label="Proiectul următor">
              <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="m6 3 5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
            </button>
          </div>
        </div>
      </SectionHeading>
    </div>

    <div class="showcase__viewport" data-sc-viewport>
      <ol class="showcase__track" data-sc-track>
        {
          panels.map(({ project, alt, cover, lightbox }, i) => (
            <li class="panel" data-sc-panel>
              <button
                type="button"
                class="panel__media"
                data-lightbox-open
                data-cursor="Vezi"
                data-images={JSON.stringify(lightbox)}
                aria-label={`Deschide galeria: ${alt}`}
              >
                <Image
                  src={cover}
                  alt={alt}
                  widths={[800, 1200, 1600]}
                  sizes="(min-width: 900px) 50vw, 84vw"
                  loading="lazy"
                  class="panel__img"
                  data-sc-img
                />
              </button>

              <div class="panel__info">
                <span class="panel__n tabular-nums" aria-hidden="true">{pad(i + 1)}</span>
                <h3>{project.title}</h3>
                <p class="label mt-2">{project.district} &middot; {project.weeks} săpt.</p>
                <hr class="panel__rule" />
                <SpecList specs={project.specs} />
              </div>
            </li>
          ))
        }

        <li class="panel panel--end" data-sc-panel>
          <p class="font-serif text-[var(--fs-h3)] leading-[1.35]">
            Încă {total - panels.length} lucrări, fiecare cu fișa ei.
          </p>
        </li>
      </ol>
    </div>
  </div>
</section>

<style>
  .showcase {
    --edge: max(var(--gutter), calc((100vw - var(--container)) / 2 + var(--gutter)));
    position: relative;
  }

  .showcase__sticky { padding-block: var(--section-y); }

  .showcase__meta {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .showcase__count {
    font-family: var(--font-serif);
    font-size: var(--fs-h3);
    color: var(--color-bone-2);
  }

  .showcase__count [data-sc-current] { color: var(--color-bone); }

  .showcase__arrows { display: flex; gap: 8px; }

  .showcase__arrow {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid rgb(242 239 234 / 0.3);
    border-radius: 8px;
    color: var(--color-bone);
    transition: border-color var(--dur) var(--ease), color var(--dur) var(--ease), opacity var(--dur) var(--ease);
  }

  .showcase__arrow:hover,
  .showcase__arrow:focus-visible { border-color: var(--color-brass); color: var(--color-brass); }

  .showcase__arrow:disabled { opacity: 0.35; pointer-events: none; }

  /* Modul de baza (sub 1024px, fara JS, miscare redusa): carusel nativ cu scroll-snap. */
  .showcase__viewport {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--edge);
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .showcase__viewport::-webkit-scrollbar { display: none; }

  .showcase__track {
    display: flex;
    gap: 16px;
    width: max-content;
    padding-inline: var(--edge);
  }

  .panel {
    scroll-snap-align: start;
    width: 85vw;
    display: grid;
    gap: 20px;
    align-content: start;
  }

  .panel__media {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius-img);
    background: var(--color-ink-3);
    cursor: zoom-in;
  }

  /* Imaginea e mai lata decat rama, ca parallax-ul orizontal sa aiba cursa. */
  .panel__img {
    position: absolute;
    top: 0;
    left: -8%;
    width: 116%;
    max-width: none;
    height: 100%;
    object-fit: cover;
    will-change: transform;
  }

  .panel__n {
    display: block;
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 6vh, 4.5rem);
    line-height: 1;
    margin-bottom: 16px;
    color: transparent;
    -webkit-text-stroke: 1px var(--color-brass);
  }

  .panel__rule {
    height: 1px;
    background: var(--color-line);
    border: 0;
    margin-block: 18px;
  }

  .panel--end {
    width: min(70vw, 360px);
    align-content: center;
  }

  @media (min-width: 700px) {
    .panel { width: min(85vw, 640px); }
  }

  @media (min-width: 1024px) {
    .showcase__track { gap: clamp(28px, 3vw, 56px); }

    .panel {
      width: clamp(820px, 72vw, 1120px);
      grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
      gap: clamp(28px, 3vw, 48px);
      align-items: start;
    }

    .panel--end { grid-template-columns: 1fr; width: 400px; }
  }

  /* Modul fixat, activat din JS doar de la 1024px */
  .showcase.is-pinned .showcase__sticky {
    position: sticky;
    top: 0;
    height: 100svh;
    display: flex;
    flex-direction: column;
    padding-top: calc(var(--header-h) + clamp(16px, 3vh, 40px));
    padding-bottom: clamp(20px, 4vh, 48px);
    overflow: hidden;
  }

  .showcase.is-pinned :global(.sh) { margin-bottom: clamp(20px, 3.5vh, 40px); }
  .showcase.is-pinned :global(.sh__title) { font-size: min(var(--fs-h2), 6.2vh); }

  /* Fereastra se taie la muchia containerului: panoul care a trecut nu mai iese in stanga ecranului. */
  .showcase.is-pinned .showcase__viewport {
    flex: 1;
    min-height: 0;
    overflow: hidden;
    scroll-snap-type: none;
    clip-path: inset(0 0 0 var(--edge));
  }

  .showcase.is-pinned .showcase__track {
    height: 100%;
    will-change: transform;
  }

  /* Randul trebuie sa fie 1fr: cu `auto`, height: 100% pe imagine nu are la ce se raporta. */
  .showcase.is-pinned .panel {
    height: 100%;
    grid-template-rows: minmax(0, 1fr);
    align-content: stretch;
    align-items: stretch;
    overflow: hidden;
  }

  .showcase.is-pinned .panel__media {
    aspect-ratio: auto;
    height: 100%;
  }

  /* Fisa sta lipita de muchia de sus a imaginii, nu jos cu golul deasupra. */
  .showcase.is-pinned .panel__info { align-self: start; }

  .showcase.is-pinned .panel--end {
    grid-template-rows: auto;
    align-content: center;
  }
</style>
