---
import { Image } from 'astro:assets';
import Button from '../ui/Button.astro';
import { resolveImage } from '../../lib/images';
import { site } from '../../data/site';
import { url } from '../../lib/url';
---

<!-- Pagina se inchide cum s-a deschis: pe benzile de LED de sub insula din hero.
     Lumina sta sus in banda, textul imediat sub ea, pe negru; banda nu trece de ~520px. -->
<section class="hc" aria-labelledby="contact-title">
  <Image
    src={resolveImage('hero-led', 'glow.jpg')}
    alt=""
    widths={[768, 1280, 1920, 2688]}
    sizes="100vw"
    loading="lazy"
    class="hc__bg"
  />

  <div class="wrap hc__inner" data-reveal>
    <div class="hc__text">
      <span class="numeral" aria-hidden="true">VII</span>
      <h2 id="contact-title" class="hc__title">Contact</h2>
      <p class="hc__lead">
        Spune-ne ce ai în cap. Măsurătorile sunt gratuite în {site.city} și nu te obligă la nimic.
      </p>
    </div>

    <div class="hc__actions">
      <a href={site.phoneHref} class="hc__phone">{site.phoneDisplay}</a>
      <Button href={url('/contact')}>Cere ofertă</Button>
      <Button href={`https://wa.me/${site.whatsappNumber}`} variant="outline">Scrie pe WhatsApp</Button>
    </div>
  </div>
</section>

<style>
  .hc {
    --glow-h: clamp(200px, 26vw, 380px);
    position: relative;
    isolation: isolate;
    overflow: clip;
    padding-block: calc(var(--glow-h) * 0.7) 64px;
    border-top: 1px solid var(--rule);
  }

  /* Fotografia nu e intunecata; doar marginea de jos se topeste in fundal. */
  .hc__bg {
    position: absolute;
    inset: 0 0 auto;
    z-index: -1;
    width: 100%;
    height: var(--glow-h);
    object-fit: cover;
    object-position: 50% 40%;
    mask: linear-gradient(180deg, #000 55%, transparent);
  }

  .hc__inner {
    display: grid;
    gap: 32px;
  }

  .hc__title {
    margin-top: 12px;
    font-size: clamp(2.5rem, 1.6rem + 4vw, 4.5rem);
  }

  .hc__lead {
    margin-top: 12px;
    max-width: 44ch;
    color: var(--text-body);
  }

  .hc__actions {
    display: grid;
    gap: 12px;
  }

  .hc__phone {
    font-family: var(--font-serif);
    font-size: var(--fs-h2);
    line-height: 1;
    margin-bottom: 12px;
    transition: color var(--dur) var(--ease);
  }

  .hc__phone:hover,
  .hc__phone:focus-visible { color: var(--accent); }

  /* Telefonul mare si cele doua butoane pe acelasi rand, centrate pe verticala. */
  @media (min-width: 768px) {
    .hc__actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 16px 12px;
    }

    .hc__phone { margin: 0 20px 0 0; }
  }

  @media (min-width: 1024px) {
    .hc__inner { grid-template-columns: 1fr auto; align-items: end; gap: 64px; }
  }
</style>
