---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { url } from '../lib/url';
import { theme } from '../lib/content';
import { deriveTheme, themeCss } from '../lib/theme';

const { scheme } = deriveTheme(theme);

interface Props {
  title: string;
  description?: string;
  /** true doar pe pagini al caror prim element e un hero cu imagine full-bleed */
  headerOverlay?: boolean;
}

const {
  title,
  description = 'Mobilă la comandă în Iași: bucătării, dressinguri, living și dormitor, proiectate 3D și executate în atelier propriu.',
  headerOverlay = false,
} = Astro.props;
---

<!doctype html>
<html lang="ro" data-scheme={scheme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={theme.background} />
    <link rel="icon" href={url('/favicon.png')} type="image/png" />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <style is:inline set:html={themeCss(theme)}></style>
  </head>
  <body>
    <a href="#continut" class="skip-link">Sari la conținut</a>

    <Header overlay={headerOverlay} />

    <main id="continut" class:list={[!headerOverlay && 'pt-[var(--header-h)]']}>
      <slot />
    </main>

    <Footer />

    <script>
      import '../scripts/hero.ts';
      import '../scripts/header.ts';
      import '../scripts/nav.ts';
      import '../scripts/filter.ts';
      import '../scripts/contact.ts';
      import '../scripts/reveal.ts';
      import '../scripts/motion.ts';
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 100;
    background: var(--color-brass);
    color: var(--color-on-accent);
    padding: 12px 20px;
    font-weight: 500;
  }

  .skip-link:focus {
    left: 8px;
    top: 8px;
  }
</style>
