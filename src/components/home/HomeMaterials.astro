---
import SectionHeading from '../ui/SectionHeading.astro';
import PriceScale from '../ui/PriceScale.astro';
import { materials } from '../../data/materials';

// Numele de furnizori apar deja in fisele proiectelor; aici sunt doar enumerate.
const brands = ['Egger', 'Blum', 'Hettich'];
---

<section class="section wrap" aria-labelledby="materiale-title">
  <SectionHeading
    n="V"
    title="Materiale"
    id="materiale-title"
    more={{ href: '/materiale', label: 'Comparația completă' }}
  />

  <div class="hm">
    <div class="hm__intro" data-reveal>
      <p class="hm__text">
        Îți arătăm mostrele și îți spunem ce merită și ce nu pentru încăperea ta. O bucătărie și un
        dressing nu cer același material.
      </p>
      <ul class="hm__brands" aria-label="Furnizori">
        {brands.map((b) => <li>{b}</li>)}
      </ul>
    </div>

    <!-- Tabelul de pe /materiale, strans la trei coloane: material, cum arata, pret. -->
    <ul class="hm__rows">
      {
        materials.map((m, i) => (
          <li class="hm__row" data-reveal style={`--i: ${i}`}>
            <h3 class="hm__name">{m.name}</h3>
            <p class="hm__look">{m.look}</p>
            <PriceScale level={m.price} />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .hm {
    display: grid;
    gap: 40px;
  }

  .hm__text {
    max-width: 44ch;
    font-family: var(--font-serif);
    font-size: var(--fs-h3);
    line-height: 1.45;
  }

  .hm__brands {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 0;
    margin-top: 28px;
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem);
    line-height: 1.2;
  }

  /* Toti trei furnizorii, si punctele dintre ei, in aceeasi nuanta. */
  .hm__brands li { color: rgb(242 239 234 / 0.6); }

  .hm__brands li + li::before {
    content: '·';
    margin-inline: 0.5em;
  }

  /* Randuri ca la Etape: linie de 1px intre ele, fara fundal si fara rama. */
  .hm__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      'name price'
      'look look';
    align-items: baseline;
    gap: 8px 24px;
    padding-block: 24px;
    border-top: 1px solid var(--rule);
  }

  .hm__row:first-child { border-top: 0; padding-top: 0; }

  .hm__name { grid-area: name; font-size: var(--fs-h3); }

  .hm__look {
    grid-area: look;
    color: var(--text-2);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .hm__row :global(.price) { grid-area: price; }

  @media (min-width: 640px) {
    .hm__row {
      grid-template-columns: minmax(0, 200px) minmax(0, 1fr) auto;
      grid-template-areas: 'name look price';
      gap: 0 32px;
    }
  }

  @media (min-width: 900px) {
    .hm__row { padding-block: 32px; }
    .hm__row:first-child { padding-top: 0; }
  }

  @media (min-width: 1024px) {
    .hm { grid-template-columns: 4fr 7fr; gap: 64px; align-items: start; }
  }
</style>
