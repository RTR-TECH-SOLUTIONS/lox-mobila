---
import Base from '../layouts/Base.astro';
import { seo } from '../data/seo';
import Materials from '../components/Materials.astro';
import CtaBand from '../components/CtaBand.astro';
import PageBanner from '../components/ui/PageBanner.astro';
---

<Base
  title={seo.materiale.title}
  description={seo.materiale.description}
  headerOverlay
>
  <PageBanner title={seo.materiale.h1} lead="Îți arătăm mostrele și îți spunem ce merită și ce nu pentru încăperea ta. O bucătărie și un dressing nu cer același material." />
  <Materials />
  <CtaBand />
</Base>
