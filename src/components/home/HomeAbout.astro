---
import { Image } from 'astro:assets';
import SectionHeading from '../ui/SectionHeading.astro';
import LitText from '../ui/LitText.astro';
import { resolveImage } from '../../lib/images';
import { site } from '../../data/site';
import { url } from '../../lib/url';
---

<section class="section container" aria-labelledby="cine-suntem-title">
  <SectionHeading n="I" title="Cine suntem" id="cine-suntem-title" />

  <!-- Fraza si atelierul unul langa altul; cifrele inchid sectiunea pe un rand, ca pe /cine-suntem. -->
  <div class="ha">
    <div data-reveal>
      <LitText
        class="ha__claim"
        text="Un perete nu e niciodată drept și o nișă nu are niciodată cât scrie în plan. De aceea măsurăm cu laserul, desenăm fiecare corp *la cotă* și montăm *de probă* în atelier înainte să ajungem la tine."
      />
    </div>

    <figure class="ha__frame" data-reveal style="--i: 1">
      <Image
        src={resolveImage('workshop', 'atelier.jpg')}
        alt="Atelierul LOX Mobila: masă de debitare CNC cu o placă de MDF pregătită"
        widths={[600, 900, 1400]}
        sizes="(min-width: 1024px) 58vw, 100vw"
        loading="lazy"
        class="ha__img"
        data-parallax="-32"
        data-parallax-scale="1.1"
      />
      <span class="photo-shade" aria-hidden="true"></span>
      <figcaption class="label ha__cap">Atelierul din {site.city}</figcaption>
    </figure>
  </div>

  <dl class="ha__stats">
    {
      site.stats.map((s, i) => (
        <div class="ha__stat" data-reveal style={`--i: ${i}`}>
          <dt class="label">{s.label}</dt>
          <dd class="ha__value tabular-nums">{s.value}</dd>
        </div>
      ))
    }
  </dl>

  <a href={url('/cine-suntem')} class="more ha__more">Despre atelier</a>
</section>

<style>
  .ha {
    display: grid;
    gap: 32px;
  }

  .ha :global(.ha__claim) {
    max-width: 20ch;
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 1rem + 2.4vw, 2rem);
    line-height: 1.15;
    letter-spacing: -0.015em;
    text-wrap: pretty;
  }

  .ha :global(.lit-em) {
    font-style: italic;
    color: var(--color-brass-hi);
  }

  .ha__frame {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-img);
  }

  .ha__img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .ha__cap {
    position: absolute;
    left: 24px;
    bottom: 20px;
    color: var(--color-bone);
  }

  /* Eticheta la stanga, cifra la dreapta, pe aceeasi linie de baza. */
  .ha__stats {
    display: grid;
    gap: 0 48px;
    margin-top: 40px;
  }

  .ha__stat {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    padding-block: 20px;
    border-top: 1px solid var(--rule);
  }

  .ha__value {
    flex: none;
    font-family: var(--font-serif);
    font-size: var(--fs-h2);
    line-height: 1;
    white-space: nowrap;
  }

  .ha__more { margin-top: 16px; }

  @media (min-width: 1024px) {
    .ha {
      grid-template-columns: 5fr 7fr;
      gap: 64px;
      align-items: start;
    }

    .ha :global(.ha__claim) { font-size: clamp(2rem, 4vw, 3rem); }
    .ha__img { aspect-ratio: 4 / 3; }

    .ha__stats { grid-template-columns: repeat(3, 1fr); margin-top: 56px; }
  }
</style>
