---
import SectionHeading from './ui/SectionHeading.astro';
import Button from './ui/Button.astro';
import { reviews } from '../data/reviews';
import { site } from '../data/site';
---

<section class="section">
  <div class="container">
    <SectionHeading n="VI" title="Recenzii" />

    <div class="reviews">
      {
        reviews.map((r, i) => (
          <figure class:list={['review', i === 1 && 'review--offset']} data-reveal>
            <blockquote>{r.text}</blockquote>
            <figcaption class="label">
              {r.author} &middot; {r.project}, {r.district}
            </figcaption>
          </figure>
        ))
      }
    </div>

    <div class="mt-14">
      <Button href={site.googleReviewsUrl} variant="link">Vezi recenziile pe Google</Button>
    </div>
  </div>
</section>

<style>
  .review {
    max-width: 60ch;
    padding-block: 36px;
    border-top: 1px solid var(--color-line);
  }

  .review blockquote {
    font-family: var(--font-serif);
    font-size: var(--fs-h3);
    line-height: 1.45;
  }

  .review figcaption { margin-top: 20px; }

  /* Alinierea alterneaza, ca sa nu fie trei blocuri identice unul sub altul. */
  @media (min-width: 900px) {
    .review--offset { margin-left: 16%; }
  }
</style>
