---
import Button from './ui/Button.astro';
import { site } from '../data/site';
import { url } from '../lib/url';
---

<section class="cta">
  <div class="container cta__inner" data-reveal>
    <div>
      <h2 class="reveal-title">Spune-ne ce ai în cap.</h2>
      <p class="mt-5 text-bone-2 max-w-[46ch]">
        Măsurătorile sunt gratuite în {site.city} și nu te obligă la nimic.
      </p>
    </div>

    <div class="cta__actions">
      <Button href={url('/#contact')}>Cere ofertă</Button>
      <a href={site.phoneHref} class="label hover:text-brass transition-colors duration-200">
        sau sună la {site.phoneDisplay}
      </a>
    </div>
  </div>
</section>

<style>
  .cta {
    border-block: 1px solid var(--color-line);
    padding-block: clamp(64px, 9vw, 120px);
  }

  .cta__inner {
    display: grid;
    gap: 40px;
    align-items: center;
  }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 24px;
  }

  @media (min-width: 900px) {
    .cta__inner {
      grid-template-columns: 1fr auto;
      gap: 64px;
    }

    .cta__actions { flex-direction: column; align-items: flex-start; }
  }
</style>
