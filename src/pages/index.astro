---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Positioning from '../components/Positioning.astro';
import Services from '../components/Services.astro';
import ProjectShowcase from '../components/ProjectShowcase.astro';
import Process from '../components/Process.astro';
import Materials from '../components/Materials.astro';
import Workshop from '../components/Workshop.astro';
import Reviews from '../components/Reviews.astro';
import CtaBand from '../components/CtaBand.astro';
import ContactForm from '../components/ContactForm.astro';
import Lightbox from '../components/Lightbox.astro';
import { projects } from '../data/projects';
import { url } from '../lib/url';

const featured = projects.filter((p) => p.featured);
---

<Base title="LOX Mobila | Mobilă la comandă în Iași" headerOverlay>
  <Hero />
  <Positioning />
  <Services />

  <ProjectShowcase projects={featured} total={projects.length} />

  <Process />
  <Materials />
  <Workshop />
  <Reviews />
  <CtaBand />
  <ContactForm />

  <Lightbox />
</Base>
