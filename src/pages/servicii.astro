---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { seo } from '../data/seo';
import PageBanner from '../components/ui/PageBanner.astro';
import PriceList from '../components/ui/PriceList.astro';
import StepList from '../components/ui/StepList.astro';
import Button from '../components/ui/Button.astro';
import CtaBand from '../components/CtaBand.astro';
import { workshopServices } from '../data/workshop';
import { site } from '../data/site';
import { resolveImage } from '../lib/images';
import { url } from '../lib/url';

// Mesajul cu care se deschide WhatsApp-ul, pe fiecare serviciu de atelier.
const whatsapp: Record<string, { label: string; text: string; alt: string }> = {
  debitare: {
    label: 'Trimite lista de piese',
    text: 'Bună ziua, am o listă de piese pentru debitare și cantuire.',
    alt: 'Masă de debitare CNC din atelierul LOX Mobila, cu plăci sprijinite de perete',
  },
  feronerie: {
    label: 'Cere prețul',
    text: 'Bună ziua, am nevoie de feronerie pentru mobilier.',
    alt: 'Sertar deschis cu glisiere cu extragere totală, într-o bucătărie montată de LOX Mobila',
  },
};

const waUrl = (text: string) => `https://wa.me/${site.whatsappNumber}?text=${encodeURIComponent(text)}`;
---

<Base
  title={seo.servicii.title}
  description={seo.servicii.description}
  headerOverlay
>
  <PageBanner
    title={seo.servicii.h1}
    lead="De la măsurători la montaj, plus debitare, cant și feronerie pentru cine își face singur mobila."
  />

  <section class="section wrap main" id="mobila-la-comanda" aria-labelledby="mlc-title">
    <div class="main__text" data-reveal="left">
      <h2 id="mlc-title">Mobilă la comandă</h2>
      <p>
        Bucătării, dressinguri, livinguri, dormitoare, băi și mobilier pentru spații comerciale,
        făcute pe cotele casei tale. Măsurăm, desenăm, debităm în atelier și montăm cu echipa
        noastră.
      </p>
      <p>Fiecare lucrare trece prin aceiași șase pași, cu termene spuse din prima zi:</p>
      <div class="main__cta">
        <Button href={url('/etape')} variant="outline">
          Vezi etapele
          <svg class="arrow" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M2 7h10M8 3l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
        </Button>
        <Button href={url('/contact')}>Cere ofertă</Button>
      </div>
    </div>

    <StepList name="servicii" data-reveal="right" style="--i: 1" />
  </section>

  {
    workshopServices.map((s, i) => (
      <section class:list={['section', 'wrap', 'svc', i % 2 === 1 && 'svc--flip']} id={s.id} aria-labelledby={`${s.id}-title`}>
        <div class="svc__photo" data-reveal="img">
          <Image
            src={resolveImage('workshop', s.image)}
            alt={whatsapp[s.id].alt}
            widths={[600, 900, 1200]}
            sizes="(min-width: 900px) 45vw, 100vw"
            loading="lazy"
          />
        </div>

        <div class="svc__body" data-reveal>
          <h2 id={`${s.id}-title`}>{s.title}</h2>
          <p class="svc__lead">{s.lead}</p>
          <PriceList columns={s.columns} rows={s.rows} note={s.note} />
          <Button href={waUrl(whatsapp[s.id].text)} variant="outline" target="_blank" rel="noopener">
            {whatsapp[s.id].label}
          </Button>
        </div>
      </section>
    ))
  }

  <CtaBand title="Nu știi de unde să începi?" lead="Hai să discutăm despre proiectul tău." />
</Base>

<style>
  .main {
    display: grid;
    gap: 40px;
    align-items: center;
  }

  .main__text { display: grid; gap: 14px; justify-items: start; }
  .main__text p { max-width: 52ch; color: var(--text-2); }
  .main__cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 12px; }

  .svc {
    display: grid;
    gap: 32px;
    align-items: center;
  }

  .svc__photo {
    height: clamp(260px, 40vw, 460px);
    overflow: hidden;
    background: var(--color-ink-2);
  }

  .svc__photo :global(img) { width: 100%; height: 100%; object-fit: cover; }

  .svc__body { display: grid; justify-items: start; gap: 16px; }
  .svc__lead { max-width: 54ch; color: var(--text-2); }
  .svc__body :global(.prices) { margin-top: 4px; }

  @media (min-width: 900px) {
    .main { grid-template-columns: 1fr 1fr; gap: 64px; }

    .svc { grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: 56px; }
    .svc__photo { height: clamp(340px, 34vw, 520px); }

    /* A doua secțiune întoarce poza pe partea cealaltă; textul rămâne coloana lată. */
    .svc--flip { grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); }
    .svc--flip .svc__photo { order: 2; }
  }
</style>
