---
import Base from '../layouts/Base.astro';
import PageBanner from '../components/ui/PageBanner.astro';
import CtaBand from '../components/CtaBand.astro';
import { processSteps } from '../data/process';
import { url } from '../lib/url';

// Aceleași șase etape ca pe prima pagină, ca în grila „Serviciile noastre” de la Mobili Design.
const icons = [
  'M4 5h16v11H8l-4 4V5Zm4 5h8M8 13h5',
  'M3 17h18M5 17V9m4 8v-5m4 5V9m4 8v-5m4 5V9',
  'M6 3h9l4 4v14H6V3Zm9 0v4h4M9 12h7m-7 4h7',
  'M12 3 3 8v8l9 5 9-5V8l-9-5Zm0 10L3 8m9 5 9-5m-9 5v8',
  'M4 20V9l5 3V9l5 3V9l6 3v8H4Zm4-4h2m4 0h2',
  'M3 7h11v9H3V7Zm11 3h4l3 3v3h-7m-9 0a2 2 0 1 0 4 0m8 0a2 2 0 1 0 4 0',
];
---

<Base
  title="Servicii | LOX Mobila Iași"
  description="De la discuție și măsurători gratuite în Iași la proiect 3D, execuție în atelier și montaj cu echipa noastră."
  headerOverlay
>
  <PageBanner
    title="Serviciile noastre"
    lead="De la prima discuție la montaj, tot ce ține de mobila ta se face la noi."
  />

  <section class="section wrap">
    <ul class="svc">
      {
        processSteps.map((s, i) => (
          <li data-reveal style={`--i: ${i % 3}`}>
            <a href={url('/etape')} class="card">
              <svg width="34" height="34" viewBox="0 0 24 24" aria-hidden="true">
                <path d={icons[i]} fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" stroke-linecap="round" />
              </svg>
              <h2>{s.title}</h2>
              <p>{s.text}</p>
              <span class="card__more">
                Citește mai mult
                <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M3.5 2.5h6v6M9.5 2.5l-7 7" fill="none" stroke="currentColor" stroke-width="1.2" /></svg>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <CtaBand title="Nu știi de unde să începi?" lead="Hai să discutăm despre proiectul tău." />
</Base>

<style>
  .svc {
    display: grid;
    gap: 14px;
  }

  .card {
    display: grid;
    justify-items: center;
    gap: 10px;
    height: 100%;
    padding: 36px 28px;
    background: var(--color-ink-2);
    text-align: center;
    transition: background-color var(--dur) var(--ease);
  }

  .card { transition: background-color var(--dur) var(--ease), transform 300ms var(--ease), box-shadow 300ms var(--ease); }
  .card:hover { background: var(--color-ink-3); transform: translateY(-6px); box-shadow: 0 24px 50px rgb(var(--shadow-rgb) / calc(0.45 * var(--shadow-k))); }
  .card > svg { transition: transform 400ms var(--ease); }
  .card:hover > svg { transform: translateY(-3px) scale(1.08); }
  .card > svg { color: var(--color-brass); margin-bottom: 6px; }
  .card h2 { font-size: 1.2rem; }
  .card p { max-width: 36ch; color: var(--text-2); font-size: 0.9rem; line-height: 1.55; }

  .card__more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 8px;
    font-size: 0.9rem;
    font-weight: 500;
  }

  .card:hover .card__more { color: var(--color-brass-hi); }

  @media (min-width: 640px) {
    .svc { grid-template-columns: repeat(2, 1fr); }
  }

  @media (min-width: 1024px) {
    .svc { grid-template-columns: repeat(3, 1fr); }
  }
</style>
