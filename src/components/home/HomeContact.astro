---
import { Image } from 'astro:assets';
import Button from '../ui/Button.astro';
import { resolveImage } from '../../lib/images';
import { site } from '../../data/site';
import { url } from '../../lib/url';
---

<!-- Pagina se inchide cum s-a deschis: pe benzile de LED de sub insula din hero. -->
<section class="hc" aria-labelledby="contact-title" data-reveal="light">
  <Image
    src={resolveImage('hero-led', 'glow.jpg')}
    alt=""
    widths={[768, 1280, 1920, 2688]}
    sizes="100vw"
    loading="lazy"
    class="hc__bg"
  />

  <div class="container hc__inner" data-reveal>
    <div>
      <span class="numeral" aria-hidden="true">VII</span>
      <h2 id="contact-title" class="hc__title reveal-title">Contact</h2>
      <p class="hc__lead">
        Spune-ne ce ai în cap. Măsurătorile sunt gratuite în {site.city} și nu te obligă la nimic.
      </p>
    </div>

    <div class="hc__actions">
      <a href={site.phoneHref} class="hc__phone">{site.phoneDisplay}</a>
      <div class="hc__buttons">
        <Button href={url('/contact')}>Cere ofertă</Button>
        <Button href={`https://wa.me/${site.whatsappNumber}`} variant="outline">Scrie pe WhatsApp</Button>
      </div>
    </div>
  </div>
</section>

<style>
  .hc {
    position: relative;
    isolation: isolate;
    overflow: clip;
    min-height: clamp(520px, 62vw, 760px);
    display: grid;
    align-items: start;
    padding-block: clamp(72px, 9vw, 128px);
    border-top: 1px solid var(--rule);
  }

  /* Banda luminata sta jos; textul are deasupra ei fundalul negru al corpurilor. */
  .hc__bg {
    position: absolute;
    inset: auto 0 0;
    z-index: -1;
    width: 100%;
    height: 78%;
    object-fit: cover;
    object-position: 50% 40%;
    mask: linear-gradient(180deg, transparent, #000 35%);
  }

  .hc__inner {
    display: grid;
    gap: 40px;
    align-items: end;
  }

  .hc__title {
    margin-top: 16px;
    font-size: clamp(2.5rem, 1.6rem + 4vw, 5rem);
  }

  .hc__lead {
    margin-top: 16px;
    max-width: 44ch;
    color: var(--text-body);
  }

  .hc__actions { display: grid; gap: 24px; }

  .hc__phone {
    font-family: var(--font-serif);
    font-size: var(--fs-h2);
    line-height: 1;
    transition: color var(--dur) var(--ease);
  }

  .hc__phone:hover { color: var(--accent); }

  .hc__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  @media (min-width: 1024px) {
    .hc__inner { grid-template-columns: 1fr auto; gap: 80px; }
  }

  /* Pe ecran ingust textul e inalt; banda de lumina coboara sub butoane, nu in spatele lor. */
  @media (max-width: 1023px) {
    .hc { padding-bottom: clamp(220px, 50vw, 360px); }
    .hc__bg { height: clamp(260px, 60vw, 420px); }
  }
</style>
