---
/**
 * Releveul desenat peste fotografia de hero.
 *
 * Muchiile NU sunt estimate: au fost detectate din imagine, cautand maximele de gradient
 * pe randuri si coloane (vezi `refs/hero-edges-check.jpg`, unde liniile gasite sunt
 * suprapuse peste poza). viewBox-ul foloseste pixelii reali ai fotografiei, ca `slice`
 * sa decupeze exact ca `object-fit: cover` de pe imagine.
 *
 * Cotele sunt consistente intre ele pe o singura scara, 2,5867 mm/px, derivata din
 * inaltimea blatului fata de podea.
 */
const W = 2688;
const H = 1520;

// procentele detectate, convertite in pixeli
const pctX = (p: number) => +((p / 100) * W).toFixed(1);
const pctY = (p: number) => +((p / 100) * H).toFixed(1);

const X = {
  window: pctX(13.39), // rama ferestrei, unde incepe frontul
  corner: pctX(68.82), // coltul dintre cele doua fronturi
  oven: pctX(78.01), // muchia coloanei de cuptor
};

const Y = {
  top: pctY(11.25), // varful corpurilor suspendate
  splash: pctY(31.25), // baza lor, unde incepe blatul de perete
  counter: pctY(44.87), // blatul
  plinth: pctY(67.76), // linia de alama de la plinta
  counterRight: pctY(47.63), // blatul dupa colt, in perspectiva
  plinthRight: pctY(76.25), // plinta dupa colt
};

const edges = [
  { d: `M${X.window} 0 V${pctY(74)}`, len: 1125 },
  { d: `M${X.window} ${Y.top} H${X.corner}`, len: 1490 },
  { d: `M${X.window} ${Y.splash} H${X.corner}`, len: 1490 },
  { d: `M${X.corner} ${Y.top} V${Y.plinth}`, len: 859 },
  { d: `M${X.window} ${Y.counter} H${X.corner} L${X.oven} ${Y.counterRight}`, len: 1748 },
  { d: `M${X.window} ${Y.plinth} H${X.corner} L${X.oven} ${Y.plinthRight}`, len: 1774 },
  { d: `M${X.oven} ${pctY(4)} V${pctY(80)}`, len: 1155 },
];

// cotele stau in jumatatea libera de text
const dims = [
  { kind: 'h', y: pctY(21), x1: X.window, x2: X.corner, label: '3 850' },
  { kind: 'v', x: pctX(72.5), y1: Y.splash, y2: Y.counter, label: '540' },
  { kind: 'v', x: pctX(72.5), y1: Y.counter, y2: Y.plinth, label: '900' },
] as const;

const TICK = 17;
---

<svg
  class="bp"
  viewBox={`0 0 ${W} ${H}`}
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  focusable="false"
>
  <g class="bp__edges">
    {
      edges.map((e, i) => (
        <path
          d={e.d}
          style={`--len: ${e.len}; --i: ${i}`}
          pathLength="1000"
          fill="none"
          stroke="currentColor"
          stroke-width="1.25"
          vector-effect="non-scaling-stroke"
        />
      ))
    }
  </g>

  <g class="bp__dims">
    {
      dims.map((dim, i) =>
        dim.kind === 'h' ? (
          <g style={`--i: ${i}`}>
            <path
              d={`M${dim.x1} ${dim.y - TICK} V${dim.y + TICK} M${dim.x2} ${dim.y - TICK} V${dim.y + TICK} M${dim.x1} ${dim.y} H${dim.x2}`}
              fill="none"
              stroke="currentColor"
              stroke-width="1.25"
              vector-effect="non-scaling-stroke"
            />
            <text x={(dim.x1 + dim.x2) / 2} y={dim.y - 16} text-anchor="middle">
              {dim.label}
            </text>
          </g>
        ) : (
          <g style={`--i: ${i}`}>
            <path
              d={`M${dim.x - TICK} ${dim.y1} H${dim.x + TICK} M${dim.x - TICK} ${dim.y2} H${dim.x + TICK} M${dim.x} ${dim.y1} V${dim.y2}`}
              fill="none"
              stroke="currentColor"
              stroke-width="1.25"
              vector-effect="non-scaling-stroke"
            />
            <text x={dim.x + 26} y={(dim.y1 + dim.y2) / 2 + 10}>{dim.label}</text>
          </g>
        ),
      )
    }
  </g>
</svg>

<style>
  .bp {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    color: var(--color-brass);
    pointer-events: none;
  }

  .bp text {
    font-family: var(--font-sans);
    font-size: 30px;
    letter-spacing: 0.14em;
    fill: var(--color-brass);
    font-variant-numeric: tabular-nums;
  }

  /* Releveul e un moment, nu o stare: peste fotografie ar aglomera permanent.
     In repaus e invizibil, si exista doar cat dureaza intrarea. */
  .bp { opacity: 0; }
  .bp__edges { opacity: 0.85; }
  .bp__dims { opacity: 1; }

  /* Fara JS sau cu miscare redusa desenul e static, exact ca mai sus. */
  :global(.has-intro) .bp__edges path {
    stroke-dasharray: 1000;
    stroke-dashoffset: 1000;
    animation: bp-draw 900ms var(--ease) forwards;
    animation-delay: calc(var(--i) * 85ms);
  }

  :global(.has-intro) .bp {
    opacity: 1;
    animation: bp-out 700ms var(--ease) 2150ms forwards;
  }

  :global(.has-intro) .bp__edges path { stroke-width: 1.6; }

  :global(.has-intro) .bp__dims g {
    opacity: 0;
    animation: bp-in 500ms var(--ease) forwards;
    animation-delay: calc(760ms + var(--i) * 130ms);
  }

  @keyframes bp-draw {
    to { stroke-dashoffset: 0; }
  }

  @keyframes bp-out {
    to { opacity: 0; }
  }

  @keyframes bp-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  /* Pe ecran ingust fotografia e decupata atat de mult incat releveul cade in afara
     cadrului: ar ramane doar cote orfane. Ramane developarea cu laser. */
  @media (max-width: 899px) {
    .bp { display: none; }
  }
</style>
