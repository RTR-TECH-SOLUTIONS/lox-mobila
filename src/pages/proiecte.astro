---
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import Lightbox from '../components/Lightbox.astro';
import CtaBand from '../components/CtaBand.astro';
import { projects } from '../data/projects';
import { site } from '../data/site';
---

<Base
  title="Proiecte | LOX Mobila Iași"
  description="Proiecte de mobilă la comandă executate în Iași: bucătării, dressinguri, living și dormitor, cu materialele și feroneria folosite la fiecare."
>
  <section class="section container">
    <SectionHeading
      n="III"
      title="Proiecte"
      as="h1"
      lead={`Douăsprezece lucrări din ultimii doi ani, toate montate în ${site.city} și împrejurimi. Fiecare are fișa ei: ce material, ce feronerie, cât a durat.`}
    />
    <ProjectGrid projects={projects} />
  </section>

  <CtaBand />
  <Lightbox />
</Base>
