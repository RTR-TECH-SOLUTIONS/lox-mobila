---
import { Image } from 'astro:assets';
import SectionHeading from './ui/SectionHeading.astro';
import { resolveImage } from '../lib/images';
import { services } from '../data/services';

interface Props {
  /** Pe prima pagina: bento cu textul pe poza si link spre pagina completa. */
  teaser?: boolean;
}

const { teaser = false } = Astro.props;
const lead =
  'Orice piesă care trebuie să intre fix într-un loc anume. Dacă se găsește gata făcută la dimensiunea ta, îți spunem de unde s-o cumperi.';
---

<section class="section wrap" aria-labelledby="ce-construim-title">
  <SectionHeading
    n="II"
    title="Ce construim"
    id="ce-construim-title"
    as={teaser ? 'h2' : 'h1'}
    lead={teaser ? undefined : lead}
    more={teaser ? { href: '/ce-construim', label: 'Detalii' } : undefined}
  />

  {
    teaser ? (
      <div class="bento">
        {services.map((s, i) => (
          <article class="bento__item" data-size={s.size} data-reveal style={`--i: ${i % 4}`}>
            <Image
              src={resolveImage('services', s.image)}
              alt={`${s.title} la comandă`}
              widths={[480, 800, 1200]}
              sizes="(min-width: 900px) 50vw, 100vw"
              loading="lazy"
            />
            <span class="photo-shade" aria-hidden="true" />
            <div class="bento__body">
              <h3>{s.title}</h3>
              <p class="bento__line">{s.line}</p>
            </div>
          </article>
        ))}
      </div>
    ) : (
  <div class="svc svc--full">
    {
      services.map((s, i) => (
        <figure class="svc__item" data-reveal style={`--i: ${i % 3}`}>
          <div class="svc__media">
            <Image
              src={resolveImage('services', s.image)}
              alt={`${s.title} la comandă`}
              widths={[480, 800, 1200]}
              sizes="(min-width: 900px) 50vw, 100vw"
              loading="lazy"
            />
          </div>
          <figcaption>
            <h3>{s.title}</h3>
            <p class="svc__line">{s.line}</p>
          </figcaption>
        </figure>
      ))
    }
  </div>
    )
  }
</section>

<style>
  /* ---------- Prima pagina: bento cu textul pe poza ---------- */
  .bento {
    display: grid;
    gap: 12px;
  }

  .bento__item {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-img);
    aspect-ratio: 4 / 3;
    isolation: isolate;
  }

  .bento__item :global(img) {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms var(--ease);
  }

  .bento__item:hover :global(img) { transform: scale(1.02); }

  /* Textul sta lipit de muchia de jos, indiferent de inaltimea cardului. */
  .bento__body {
    position: absolute;
    inset: auto 0 0;
    padding: 24px;
  }

  .bento h3 { font-size: 1.5rem; }

  .bento__line {
    margin-top: 6px;
    max-width: 40ch;
    color: rgb(242 239 234 / 0.82);
    font-size: 0.95rem;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (min-width: 900px) {
    /* Toate randurile au aceeasi inaltime: bucataria ocupa trei, restul cate unul. */
    .bento {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: clamp(220px, 19vw, 280px);
    }

    .bento__item { aspect-ratio: auto; }
    .bento__item[data-size='lg'] { grid-row: span 3; }
    .bento__item[data-size='lg'] .bento__body { padding: 32px; }
    .bento__item[data-size='lg'] h3 { font-size: var(--fs-h2); }
  }

  /* ---------- Pagina completa: legenda sub poza ---------- */
  .svc {
    display: grid;
    gap: 48px 24px;
  }

  .svc__media {
    overflow: hidden;
    border-radius: var(--radius-img);
    background: var(--color-ink-2);
  }

  .svc__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: 4 / 5;
    transition: transform 400ms var(--ease);
  }

  .svc__item:hover .svc__media :global(img) { transform: scale(1.02); }

  .svc figcaption { margin-top: 20px; }

  /* Sub titlu, o linie de alama care se intinde la hover. */
  .svc h3 {
    display: inline-block;
    background: linear-gradient(var(--accent), var(--accent)) 0 100% / 0 1px no-repeat;
    padding-bottom: 4px;
    transition: background-size 500ms var(--ease);
  }

  .svc__item:hover h3 { background-size: 100% 1px; }

  .svc__line {
    margin-top: 8px;
    max-width: 40ch;
    color: var(--text-2);
    font-size: 0.95rem;
  }

  /* Pe telefon cadrul vertical ar lungi pagina de trei ori; orizontal e destul. */
  @media (max-width: 699px) {
    .svc__media :global(img) { aspect-ratio: 4 / 3; }
  }

  @media (min-width: 700px) {
    .svc { grid-template-columns: repeat(2, 1fr); }
  }

  @media (min-width: 900px) {

    /* Pagina completa: doua cadre mari, apoi patru mici. */
    .svc--full { grid-template-columns: repeat(12, 1fr); }
    .svc--full .svc__item { grid-column: span 3; }
    .svc--full .svc__item:nth-child(-n + 2) { grid-column: span 6; }
    .svc--full .svc__item:nth-child(-n + 2) .svc__media :global(img) { aspect-ratio: 4 / 3; }
  }

  @media (prefers-reduced-motion: reduce) {
    .bento__item:hover :global(img),
    .svc__item:hover .svc__media :global(img) { transform: none; }
  }
</style>
