---
import { getImage } from 'astro:assets';
import Button from './ui/Button.astro';
import { resolveImage } from '../lib/images';
import { site } from '../data/site';
import { url } from '../lib/url';

// Straturile vin din scripts/hero-led.py: baza stinsa + cate un strat de lumina pe zona.
// Fiecare strat are doua cadre, lat (desktop) si vertical (`m-`, telefon), cu aceeasi cheie,
// ca pe telefon sa se vada toate LED-urile, nu doar mijlocul pozei late.
// `at` = momentul aprinderii (ms), `fx` = cum se aprinde.
const layers = [
  { key: 'off', at: 0, fx: '' },
  { key: 's1', at: 300, fx: 'flicker' },
  { key: 's2', at: 560, fx: 'flicker' },
  { key: 's3', at: 820, fx: 'flicker' },
  { key: 'bs', at: 1150, fx: 'sweep-x' },
  { key: 'vt', at: 1700, fx: 'sweep-y' },
  { key: 'tk', at: 2150, fx: 'flicker' },
  { key: 'is', at: 2350, fx: 'sweep-x' },
  { key: 'amb', at: 2800, fx: 'fade' },
] as const;

const MOBILE = '(max-width: 800px) and (orientation: portrait)';

const pictures = await Promise.all(
  layers.map(async (l) => {
    const [wide, tall] = await Promise.all([
      getImage({ src: resolveImage('hero-led', `${l.key}.jpg`), widths: [1280, 1920, 2688], format: 'webp' }),
      getImage({ src: resolveImage('hero-led', `m-${l.key}.jpg`), widths: [640, 960, 1520], format: 'webp' }),
    ]);
    return { ...l, wide, tall };
  }),
);
---

<section class="hero" aria-labelledby="hero-title" data-hero>
  <div class="hero__scene">
    {
      pictures.map((p) => (
        <picture>
          <source media={MOBILE} srcset={p.tall.srcSet.attribute} sizes="100vw" />
          <img
            src={p.wide.src}
            srcset={p.wide.srcSet.attribute}
            sizes="100vw"
            alt={p.key === 'off' ? 'Bucătărie LOX cu iluminare LED integrată în corpuri, în rafturi și pe plinte' : ''}
            class:list={['hero__img', p.key !== 'off' && 'hero__light']}
            data-at={p.key !== 'off' ? p.at : undefined}
            data-fx={p.fx || undefined}
            loading="eager"
            fetchpriority={p.key === 'off' ? 'high' : undefined}
            decoding="async"
          />
        </picture>
      ))
    }
  </div>

  <div class="hero__veil" aria-hidden="true"></div>

  <div class="wrap hero__inner">
    <h1 id="hero-title">De la măsurători <br />la montaj, în <em>atelierul</em> nostru.</h1>
    <p class="hero__lead">
      Bucătării, dressinguri și mobilier la comandă în {site.city}, făcute pe cotele casei tale,
      nu pe ale unui catalog.
    </p>
    <div class="hero__cta">
      <Button href={url('/contact')}>Cere ofertă</Button>
      <Button href={url('/proiecte')} variant="outline">Vezi proiectele</Button>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: max(100svh, 620px);
    display: grid;
    place-items: center;
    isolation: isolate;
    overflow: clip;
    background: #000;
  }

  .hero__scene { position: absolute; inset: 0; z-index: -2; }

  .hero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 0;
  }

  /* Lumina se aduna peste baza stinsa: toate straturile aprinse = fotografia intreaga. */
  .hero__light { mix-blend-mode: plus-lighter; }

  /* Voalul estompeaza scena cat sa se citeasca textul; header-ul are nevoie de umbra sus,
     iar butoanele de un gradient de jos, ca sa nu stea pe blatul luminat. */
  .hero__veil {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(180deg, rgb(0 0 0 / 0.5), transparent 18%),
      linear-gradient(0deg, rgb(12 12 12 / 0.85) 0%, rgb(12 12 12 / 0.4) 35%, transparent 60%),
      rgb(0 0 0 / 0.45);
  }

  /* Acelasi spatiu sus si jos, ca textul sa stea exact la mijlocul ecranului. */
  .hero__inner {
    padding-block: calc(var(--header-h) + 32px);
    text-align: center;
  }

  .hero__veil,
  .hero__inner { transition: opacity 800ms var(--ease); }

  /* Pe ecran ingust ruptura fixa lasa „nostru." singur pe rand; acolo echilibreaza browserul. */
  @media (max-width: 639px) {
    .hero h1 br { display: none; }
  }

  .hero h1 em {
    font-style: italic;
    color: var(--color-brass-hi);
  }

  .hero__lead {
    max-width: 46ch;
    margin: 18px auto 0;
    color: rgb(242 239 234 / 0.85);
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 12px;
    margin-top: 32px;
  }


  /* ---------- Aprinderea ----------
     .is-lighting o pune JS-ul. Fara el (fara JS sau cu reduced motion) scena e deja aprinsa
     si textul e pe loc. Cu el, bucataria se aprinde intai in plin, apoi (.is-lit) coboara
     voalul si apare textul. */
  :global(.is-lighting) .hero__light { opacity: 0; }

  :global(.is-lighting:not(.is-lit)) .hero__veil,
  :global(.is-lighting:not(.is-lit)) .hero__inner { opacity: 0; }

  :global(.is-lighting) .hero__light.is-on[data-fx='flicker'] { animation: led-flicker 700ms linear both; }
  :global(.is-lighting) .hero__light.is-on[data-fx='fade'] { animation: led-fade 900ms var(--ease) both; }

  :global(.is-lighting) .hero__light.is-on[data-fx='sweep-x'] {
    mask: linear-gradient(90deg, #000 46%, transparent 54%) 0 0 / 300% 100% no-repeat;
    animation:
      led-fade 200ms linear both,
      led-sweep-x 1100ms cubic-bezier(0.5, 0, 0.3, 1) both;
  }

  :global(.is-lighting) .hero__light.is-on[data-fx='sweep-y'] {
    mask: linear-gradient(180deg, #000 46%, transparent 54%) 0 0 / 100% 300% no-repeat;
    animation:
      led-fade 150ms linear both,
      led-sweep-y 900ms cubic-bezier(0.5, 0, 0.3, 1) both;
  }

  /* Un LED real pornește cu o scurta palpaire, nu cu un fade. */
  @keyframes led-flicker {
    0% { opacity: 0; }
    6% { opacity: 0.8; }
    11% { opacity: 0.1; }
    18% { opacity: 1; }
    24% { opacity: 0.35; }
    34%, 100% { opacity: 1; }
  }

  @keyframes led-fade {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes led-sweep-x {
    from { mask-position: 100% 0; }
    to { mask-position: 0 0; }
  }

  @keyframes led-sweep-y {
    from { mask-position: 0 100%; }
    to { mask-position: 0 0; }
  }

  /* Pe telefon vertical vine cadrul vertical; textul sta la mijloc, pe o banda mai intunecata. */
  @media (max-width: 800px) and (orientation: portrait) {

    /* Cadrul ocupa toata latimea si coboara cat e el de inalt: taiat pe laturi, ar pierde
       rafturile din stanga si profilul vertical din dreapta. Sub el, podeaua trece in negru. */
    .hero__img {
      bottom: auto;
      height: auto;
      aspect-ratio: 1520 / 2688;
    }

    .hero__scene::after {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      top: calc(100vw * 2688 / 1520 - 160px);
      height: 160px;
      background: linear-gradient(180deg, transparent, #000);
    }

    .hero__veil {
      background:
        linear-gradient(180deg, rgb(0 0 0 / 0.5), transparent 16%),
        linear-gradient(180deg, transparent 20%, rgb(0 0 0 / 0.55) 40%, rgb(0 0 0 / 0.55) 62%, transparent 82%);
    }
  }
</style>
