---
import { Image } from 'astro:assets';
import SpecList from './ui/SpecList.astro';
import { resolveImage } from '../lib/images';
import { buildLightboxImages, projectAlt } from '../lib/lightbox-images';
import type { Project } from '../data/types';

interface Props {
  project: Project;
}

const { project } = Astro.props;

const cover = resolveImage('projects', project.cover);
const alt = projectAlt(project);
const lightboxImages = await buildLightboxImages(project);
---

<article
  class="card"
  data-project
  data-category={project.category}
  data-reveal
>
  <button
    type="button"
    class="card__media"
    data-lightbox-open
    data-cursor="Vezi"
    data-images={JSON.stringify(lightboxImages)}
    aria-label={`Deschide galeria: ${alt}`}
  >
    <Image
      src={cover}
      alt={alt}
      widths={[480, 800, 1200]}
      sizes="(min-width: 1100px) 33vw, (min-width: 700px) 50vw, 100vw"
      loading="lazy"
    />
  </button>

  <div class="card__head">
    <h3>{project.title}</h3>
    <p class="label shrink-0">{project.district} &middot; {project.weeks} săpt.</p>
  </div>

  <hr class="card__rule" />

  <SpecList specs={project.specs} />
</article>

<style>
  .card__media {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius-img);
    background: var(--color-ink-2);
    cursor: zoom-in;
  }

  .card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms var(--ease);
  }

  .card__media:hover :global(img),
  .card__media:focus-visible :global(img) { transform: scale(1.02); }

  .card__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-top: 20px;
  }

  .card__rule {
    height: 1px;
    background: var(--color-line);
    border: 0;
    margin-block: 16px;
  }

  @media (prefers-reduced-motion: reduce) {
    .card__media:hover :global(img) { transform: none; }
  }
</style>
