---
import { site } from '../../data/site';
---

<section class="stats" aria-label="LOX Mobila în cifre">
  <dl class="wrap stats__list">
    {
      site.stats.map((s, i) => (
        <div class="stat" data-reveal style={`--i: ${i * 2}`}>
          <dd class="tabular-nums">{s.value}</dd>
          <dt>{s.label[0].toUpperCase() + s.label.slice(1)}</dt>
        </div>
      ))
    }
  </dl>
</section>

<style>
  .stats { padding-block: calc(var(--section-y) * 0.75); }
  .stats + :global(.section) { padding-top: calc(var(--section-y) * 0.25); }

  .stats__list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    max-width: 900px;
  }

  .stat {
    display: grid;
    justify-items: center;
    gap: 6px;
    padding-inline: 8px;
    text-align: center;
  }

  .stat + .stat { border-left: 1px solid var(--rule); }

  .stat dd {
    order: -1;
    font-size: clamp(1.75rem, 1.2rem + 2.2vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
    white-space: nowrap;
  }

  .stat dt { color: var(--text-2); font-size: 0.9rem; }
</style>
