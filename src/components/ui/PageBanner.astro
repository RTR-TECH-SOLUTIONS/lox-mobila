---
import { Image } from 'astro:assets';
import { resolveImage } from '../../lib/images';
import { categoryPages } from '../../data/categories';
import { projects } from '../../data/projects';
import { url } from '../../lib/url';
import { worksLabel } from '../../lib/catalog';

interface Props {
  title: string;
  lead?: string;
  /** Rândul de categorii din banner, ca pe paginile de mobilier. `active` = categoria curentă. */
  categories?: boolean;
  active?: string;
}

const { title, lead, categories = false, active } = Astro.props;

const icons: Record<string, string> = {
  bucatarii: 'M3 20h18M4 20V9h16v11M4 13h16M9 9V4h6v5M8 16h1m6 0h1',
  dressing: 'M4 3h16v18H4V3Zm8 0v18M9 11v2m6-2v2',
  dormitor: 'M3 19v-7h18v7M3 15h18M5 12V8a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v4M3 19v2m18-2v2',
  living: 'M3 18h18M5 18v-5h14v5M3 11a2 2 0 0 1 2 2m14 0a2 2 0 0 1 2-2M7 13V8h10v5',
};
---

<!-- Bannerul paginilor interioare: poza întunecată, titlul centrat, ca la mobilidesign.ro. -->
<section class:list={['pb', categories && 'pb--cats']}>
  <Image
    src={resolveImage('hero-led', 'amb.jpg')}
    alt=""
    widths={[800, 1400, 2000]}
    sizes="100vw"
    loading="eager"
    class="pb__img"
  />
  <div class="wrap pb__inner">
    <h1>{title}</h1>
    {lead && <p class="pb__lead">{lead}</p>}

    {
      categories && (
        <ul class="pb__cats">
          {categoryPages.map((c) => (
            <li>
              <a
                href={url(`/mobilier/${c.key}`)}
                class="pb__cat"
                aria-current={active === c.key ? 'page' : undefined}
              >
                <svg width="30" height="30" viewBox="0 0 24 24" aria-hidden="true">
                  <path d={icons[c.key]} fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" stroke-linecap="round" />
                </svg>
                <span>
                  <span class="pb__cat-name">{c.label}</span>
                  <span class="pb__cat-n">{worksLabel(projects.filter((p) => p.category === c.key).length)}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>

<style>
  .pb {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    align-items: center;
    min-height: clamp(220px, 30vw, 340px);
    padding-top: var(--header-h);
    text-align: center;
  }

  .pb__img {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.35);
    animation: banner-in 2400ms cubic-bezier(0.22, 0.61, 0.36, 1) both;
  }

  .pb__inner > * { animation: rise 800ms var(--ease) both; }
  .pb__inner > :nth-child(2) { animation-delay: 120ms; }
  .pb__inner > :nth-child(3) { animation-delay: 240ms; }

  @keyframes banner-in {
    from { transform: scale(1.12); filter: brightness(0.1); }
  }

  .pb__inner { padding-block: 40px; }

  .pb h1 { font-size: clamp(1.75rem, 1.3rem + 1.8vw, 2.75rem); }

  .pb__lead {
    max-width: 60ch;
    margin: 10px auto 0;
    color: rgb(242 239 234 / 0.82);
  }

  .pb__cats {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 36px;
    margin-top: 28px;
  }

  .pb__cat {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    color: rgb(242 239 234 / 0.7);
    text-align: left;
    transition: color var(--dur) var(--ease);
  }

  .pb__cat:hover,
  .pb__cat[aria-current='page'] { color: var(--color-bone); }
  .pb__cat[aria-current='page'] svg { color: var(--color-brass); }

  .pb__cat > span { display: grid; }
  .pb__cat-name { font-size: 0.85rem; font-weight: 600; }
  .pb__cat-n { font-size: 0.75rem; opacity: 0.8; }
</style>
