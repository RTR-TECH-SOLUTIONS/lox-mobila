---
import { Image } from 'astro:assets';
import SectionHeading from '../ui/SectionHeading.astro';
import LitText from '../ui/LitText.astro';
import { resolveImage } from '../../lib/images';
import { site } from '../../data/site';
import { url } from '../../lib/url';
---

<section class="section wrap" aria-labelledby="cine-suntem-title">
  <SectionHeading n="I" title="Cine suntem" id="cine-suntem-title" />

  <!-- Fraza e piesa sectiunii: mare, pe toata latimea, o singura declaratie. -->
  <div data-reveal>
    <LitText
      class="ha__claim"
      text="Un perete nu e niciodată drept și o nișă nu are niciodată cât scrie în plan. De aceea măsurăm cu laserul, desenăm fiecare corp *la cotă* și montăm *de probă* în atelier înainte să ajungem la tine."
    />
  </div>

  <div class="ha">
    <figure class="ha__frame" data-reveal>
      <div class="ha__media">
        <Image
          src={resolveImage('workshop', 'atelier.jpg')}
          alt="Atelierul LOX Mobila: masă de debitare CNC cu o placă de MDF pregătită"
          widths={[600, 900, 1400]}
          sizes="(min-width: 1024px) 58vw, 100vw"
          loading="lazy"
          class="ha__img"
          data-parallax="-32"
          data-parallax-scale="1.1"
        />
      </div>
      <figcaption class="label ha__cap">Atelierul din {site.city}</figcaption>
    </figure>

    <div class="ha__side">
      <dl class="ha__stats">
        {
          site.stats.map((s, i) => (
            <div class="ha__stat" data-reveal style={`--i: ${i}`}>
              <dt class="label">{s.label}</dt>
              <dd class="ha__value tabular-nums">{s.value}</dd>
            </div>
          ))
        }
      </dl>

      <a href={url('/cine-suntem')} class="more" data-reveal style="--i: 3">Despre atelier</a>
    </div>
  </div>
</section>

<style>
  .section :global(.ha__claim) {
    max-width: 28ch;
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 1rem + 3vw, 3.75rem);
    line-height: 1.15;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .section :global(.ha__claim .lit-em) {
    font-style: italic;
    color: var(--color-brass-hi);
  }

  .ha {
    display: grid;
    gap: 48px;
    margin-top: clamp(56px, 7vw, 104px);
  }

  .ha__media {
    overflow: hidden;
    border-radius: var(--radius-img);
  }

  .ha__img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  /* Eticheta sta sub poza, nu peste ea: imaginea ramane fara voal. */
  .ha__cap {
    margin-top: 12px;
    color: var(--text-2);
  }

  .ha__side {
    display: grid;
    gap: 32px;
    align-content: space-between;
  }

  .ha__stats { display: grid; }

  .ha__stat {
    display: grid;
    gap: 8px;
    padding-block: 22px;
    border-top: 1px solid var(--rule);
  }

  .ha__stat:first-child { border-top: 0; padding-top: 0; }

  /* In HTML eticheta (dt) vine prima; vizual cifra sta deasupra. */
  .ha__value {
    order: -1;
    font-family: var(--font-serif);
    font-size: clamp(3rem, 2rem + 3vw, 5rem);
    line-height: 0.95;
    white-space: nowrap;
  }

  @media (max-width: 1023px) {
    .ha__stats { grid-template-columns: repeat(3, 1fr); gap: 16px; }
    .ha__stat { border-top: 0; padding: 0; }
    .ha__value { font-size: clamp(2rem, 1.2rem + 4vw, 3rem); }
  }

  @media (min-width: 1024px) {
    .ha { grid-template-columns: 7fr 4fr; gap: clamp(48px, 7vw, 112px); align-items: stretch; }
  }
</style>
