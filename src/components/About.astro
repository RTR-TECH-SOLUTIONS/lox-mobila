---
import { Image } from 'astro:assets';
import SectionHeading from './ui/SectionHeading.astro';
import { resolveImage } from '../lib/images';
import { site } from '../data/site';

const claim =
  'Un perete nu e niciodată drept și o nișă nu are niciodată cât scrie în plan. De aceea măsurăm cu laserul, desenăm fiecare corp la cotă și montăm de probă în atelier înainte să ajungem la tine.';
---

<section class="section wrap" aria-labelledby="cine-suntem-title">
  <SectionHeading n="I" title="Cine suntem" id="cine-suntem-title" as="h1" />

  <div class="about">
    <figure class="about__frame" data-reveal>
      <Image
        src={resolveImage('workshop', 'atelier.jpg')}
        alt="Atelierul LOX Mobila: masă de debitare CNC cu o placă de MDF pregătită"
        widths={[600, 900, 1400]}
        sizes="(min-width: 1024px) 58vw, 100vw"
        loading="lazy"
        class="about__img"
        data-parallax="-32"
        data-parallax-scale="1.1"
      />
    </figure>

    <div class="about__text" data-reveal>
      <p class="about__claim">{claim}</p>

      <p>
        Tot ce montăm iese din atelierul nostru din {site.city}. Nu revindem mobilă făcută de
        alții și nu dăm montajul pe mâna altcuiva.
      </p>
      <p>
        Plăcile se debitează pe CNC, direct din fișierul proiectului tău, așa că piesa din
        atelier are exact cota din desen. Canturile se aplică la cald, cu adeziv
        poliuretanic, care rezistă la abur și la apă.
      </p>
      <p class="about__punch">
        Înainte de livrare asamblăm totul de probă. Dacă o ușă freacă, freacă la noi, nu la
        tine în bucătărie.
      </p>
    </div>
  </div>

  <dl class="about__stats" data-reveal>
    {
      site.stats.map((s) => (
        <div class="about__stat">
          <dt class="label">{s.label}</dt>
          <dd class="about__value tabular-nums">{s.value}</dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  .about {
    display: grid;
    gap: 40px;
  }

  .about__frame {
    overflow: hidden;
    border-radius: var(--radius-img);
  }

  .about__img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .about__text {
    display: grid;
    gap: 24px;
    align-content: start;
    color: var(--text-body);
  }

  .about__claim {
    font-family: var(--font-serif);
    font-size: var(--fs-h3);
    line-height: 1.45;
    color: var(--text);
  }

  .about__punch { color: var(--text); }

  /* Cifrele inchid sectiunea: eticheta la stanga, valoarea la dreapta. */
  .about__stats {
    display: grid;
    gap: 0 48px;
    margin-top: clamp(40px, 5vw, 56px);
  }

  .about__stat {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    padding-block: 20px 0;
    border-top: 1px solid var(--rule);
  }

  /* „2 mm" se rupea pe doua randuri si scotea a treia cifra din linie. */
  .about__value {
    flex: none;
    font-family: var(--font-serif);
    font-size: var(--fs-h2);
    line-height: 1;
    white-space: nowrap;
  }

  @media (min-width: 1024px) {
    .about {
      grid-template-columns: repeat(12, 1fr);
      gap: 64px;
      align-items: center;
    }

    .about__frame { grid-column: span 7; }
    .about__text { grid-column: 8 / -1; }

    .about__stats { grid-template-columns: repeat(3, 1fr); }
  }
</style>
