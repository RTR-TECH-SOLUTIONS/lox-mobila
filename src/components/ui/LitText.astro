---
/**
 * Paragraf cu cuvinte scoase in evidenta: textul intre *asteriscuri* iese italic, pe alama,
 * ca „atelierul" din hero. Apare dintr-o bucata, cu reveal-ul obisnuit.
 */
interface Props {
  text: string;
  as?: 'p' | 'blockquote';
  class?: string;
}

const { text, as: Tag = 'p', class: cls } = Astro.props;

const parts = text.split(/(\*[^*]+\*)/).filter(Boolean).map((part) => ({
  text: part.replace(/\*/g, ''),
  em: part.startsWith('*'),
}));
---

<Tag class={cls}>{parts.map((p) => (p.em ? <em class="lit-em">{p.text}</em> : p.text))}</Tag>
