---
import SectionHeading from '../ui/SectionHeading.astro';
import { processSteps } from '../../data/process';
---

<section class="section container" aria-labelledby="etape-title">
  <SectionHeading
    n="IV"
    title="Etapele lucrării"
    id="etape-title"
    more={{ href: '/etape', label: 'Pas cu pas' }}
  />

  <!-- Randurile din lista veche, fara descrieri. Fiecare rand are banda lui de LED; se aprind pe rand. -->
  <ol class="hpr" data-reveal>
    {
      processSteps.map((s, i) => (
        <li class="hpr__step" style={`--i: ${i}`}>
          <span class="led hpr__led" aria-hidden="true" />
          <span class="hpr__n" aria-hidden="true">{s.n}</span>
          <h3 class="hpr__title">{s.title}</h3>
          <p class="label hpr__dur">{s.duration}</p>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .hpr__step {
    position: relative;
    display: grid;
    grid-template-columns: 56px 1fr auto;
    align-items: baseline;
    gap: 0 24px;
    padding-block: 24px;
  }

  .hpr__led {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
  }

  :global(.has-reveal) .hpr:not(.is-in) .hpr__led::after { transform: scaleX(0); }
  :global(.has-reveal) .hpr.is-in .hpr__led::after {
    animation: led-line 900ms cubic-bezier(0.5, 0, 0.3, 1) both;
    animation-delay: calc(var(--i) * 220ms);
  }

  .hpr__n {
    font-family: var(--font-serif);
    font-size: var(--fs-h3);
    color: var(--accent);
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .hpr__title { font-size: var(--fs-h3); }

  .hpr__dur { text-align: right; }

  @media (min-width: 900px) {
    .hpr__step { grid-template-columns: 96px 1fr auto; gap: 0 40px; padding-block: 28px; }
  }
</style>
