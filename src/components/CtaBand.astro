---
import { Image } from 'astro:assets';
import Button from './ui/Button.astro';
import { resolveImage } from '../lib/images';
import { site } from '../data/site';
import { url } from '../lib/url';

interface Props {
  title?: string;
  lead?: string;
}

const {
  title = `Mobilier la comandă, în ${site.city}.`,
  lead = 'Măsurătorile sunt gratuite și nu te obligă la nimic.',
} = Astro.props;
---

<!-- Banda de dinaintea subsolului: poza intunecata, titlu la stanga, butonul la dreapta. -->
<section class="cta">
  <Image
    src={resolveImage('hero-led', 'glow.jpg')}
    alt=""
    widths={[800, 1400, 2000]}
    sizes="100vw"
    loading="lazy"
    class="cta__img"
    data-parallax="-50"
    data-parallax-scale="1.25"
  />
  <div class="wrap cta__inner">
    <div>
      <h2>{title}</h2>
      <p>{lead}</p>
    </div>
    <Button href={url('/contact')}>
      Cere ofertă
      <svg class="arrow" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M2 7h10M8 3l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
    </Button>
  </div>
</section>

<style>
  .cta {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    margin-top: var(--section-y);
  }

  .cta__img {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.45);
  }

  .cta__inner {
    display: grid;
    gap: 24px;
    align-items: center;
    padding-block: clamp(48px, 6vw, 80px);
  }

  .cta h2 { font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem); }
  .cta p { margin-top: 8px; color: rgb(242 239 234 / 0.8); }

  @media (min-width: 768px) {
    .cta__inner { grid-template-columns: 1fr auto; gap: 48px; }
  }
</style>
