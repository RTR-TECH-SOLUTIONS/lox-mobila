---
import SectionHeading from './ui/SectionHeading.astro';
import PriceScale from './ui/PriceScale.astro';
import { materials, hardwareNote } from '../data/materials';
---

<section class="section">
  <div class="wrap">
    <SectionHeading
      n="V"
      title="Materiale"
      as="h1"
      lead="Îți arătăm mostrele și îți spunem ce merită și ce nu pentru încăperea ta. O bucătărie și un dressing nu cer același material."
    />

    <table class="mat" data-reveal>
      <caption class="sr-only">
        Comparație între materialele folosite pentru fronturi și carcase
      </caption>
      <thead>
        <tr>
          <th scope="col" class="label">Material</th>
          <th scope="col" class="label">Cum arată</th>
          <th scope="col" class="label">Umezeală</th>
          <th scope="col" class="label">Unde îl folosim</th>
          <th scope="col" class="label">Preț</th>
        </tr>
      </thead>
      <tbody>
        {
          materials.map((m) => (
            <tr>
              <th scope="row" class="mat__name">{m.name}</th>
              <td data-label="Cum arată">{m.look}</td>
              <td data-label="Umezeală">{m.moisture}</td>
              <td data-label="Unde îl folosim">{m.bestFor}</td>
              <td data-label="Preț">
                <PriceScale level={m.price} />
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>

    <p class="hardware" data-reveal>{hardwareNote}</p>
  </div>
</section>

<style>
  .mat {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
  }

  .mat thead th {
    padding-bottom: 16px;
    font-weight: 400;
    vertical-align: bottom;
  }

  .mat tbody tr { border-top: 1px solid var(--rule); }

  .mat td,
  .mat th[scope='row'] {
    padding-block: 22px;
    padding-right: 24px;
    vertical-align: top;
  }

  .mat td { color: var(--text-body); }

  .mat__name {
    font-family: var(--font-serif);
    font-size: var(--fs-h3);
    font-weight: 400;
    color: var(--text);
    padding-right: 32px;
  }

  @media (min-width: 900px) {
    /* Numele materialului sta pe un rand; altfel "PAL melaminat" se rupe urat. */
    .mat__name { width: 1%; white-space: nowrap; }
  }

  .mat td :global(.price) { margin-top: 10px; }

  .hardware {
    margin-top: 48px;
    max-width: 60ch;
    padding-left: 24px;
    border-left: 1px solid var(--accent);
    color: var(--text-body);
  }

  /* Sub 900px fiecare rand devine un card cu eticheta si valoare. */
  @media (max-width: 899px) {
    .mat thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }

    .mat tbody { display: grid; gap: 12px; }

    .mat tbody tr {
      display: block;
      padding: 24px;
      border: 1px solid var(--rule);
      border-radius: var(--radius-img);
      background: var(--color-ink-2);
    }

    .mat th[scope='row'] {
      display: block;
      padding: 0 0 14px;
    }

    .mat td {
      display: grid;
      grid-template-columns: 120px 1fr;
      align-items: baseline;
      gap: 16px;
      padding: 6px 0;
    }

    .mat td :global(.price) { margin-top: 0; }

    .mat td::before {
      content: attr(data-label);
      font-size: var(--fs-label);
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--text-2);
    }
  }
</style>
