---
import Base from '../layouts/Base.astro';
import { seo } from '../data/seo';
import Process from '../components/Process.astro';
import CtaBand from '../components/CtaBand.astro';
import PageBanner from '../components/ui/PageBanner.astro';
---

<Base
  title={seo.etape.title}
  description={seo.etape.description}
  headerOverlay
>
  <PageBanner title={seo.etape.h1} lead="Șase pași, aceiași de fiecare dată. Știi din prima zi ce urmează și cât durează." />
  <Process />
  <CtaBand />
</Base>
