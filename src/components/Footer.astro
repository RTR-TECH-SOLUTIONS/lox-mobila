---
import Logo from './ui/Logo.astro';
import { site } from '../data/site';
import { url } from '../lib/url';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap footer__inner">
    <div class="footer__grid">
      <!-- Tagline-ul din imaginea logo-ului nu se citea la marimea asta; e pus ca text. -->
      <div class="footer__brand">
        <Logo height={40} />
        <p class="footer__tagline">{site.tagline}</p>
      </div>

      <nav aria-label="Secundar">
        <ul class="footer__list">
          {
            site.nav.map((item) => (
              <li>
                <a href={url(item.href)} class="footer__link">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <ul class="footer__list">
        <li><a href={site.phoneHref} class="footer__link">{site.phoneDisplay}</a></li>
        <li><a href={`mailto:${site.email}`} class="footer__link">{site.email}</a></li>
        <li><a href={site.mapsUrl} class="footer__link">{site.address}</a></li>
      </ul>

      <div>
        <dl class="footer__hours">
          {
            site.hours.map((h) => (
              <div>
                <dt>{h.days}</dt>
                <dd>{h.time}</dd>
              </div>
            ))
          }
        </dl>

        <ul class="footer__social">
          {
            site.social.map((s) => (
              <li>
                <a href={s.href} class="footer__link">
                  {s.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <p class="label footer__legal">
      &copy; {year} {site.name} &middot; {site.tagline}
    </p>
  </div>
</footer>

<style>
  .footer { border-top: 1px solid var(--rule); }

  .footer__inner { padding-block: 48px 32px; }

  .footer__grid {
    display: grid;
    gap: 40px;
  }

  .footer__brand {
    display: grid;
    justify-items: center;
    gap: 14px;
  }

  .footer__tagline {
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-indent: 0.18em;
    text-transform: uppercase;
    color: var(--text-2);
  }

  /* Toate datele de contact la aceeasi culoare; doar hover-ul schimba ceva. */
  .footer__list { display: grid; gap: 4px; align-content: start; }

  .footer__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--text-body);
    transition: color var(--dur) var(--ease);
  }

  .footer__link:hover,
  .footer__link:focus-visible { color: var(--accent); }

  .footer__hours { display: grid; gap: 4px; max-width: 320px; }

  .footer__hours div {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 44px;
    color: var(--text-body);
  }

  .footer__hours dt { color: var(--text-2); }
  .footer__hours dd { white-space: nowrap; }

  .footer__social {
    display: flex;
    gap: 24px;
    margin-top: 4px;
  }

  .footer__legal {
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--rule);
  }

  @media (min-width: 768px) {
    .footer__inner { padding-block: 64px 32px; }
    .footer__grid { grid-template-columns: repeat(2, 1fr); gap: 48px; }
    .footer__brand { justify-items: start; align-content: start; }
  }

  @media (min-width: 1024px) {
    .footer__grid { grid-template-columns: 1fr 1fr 1.2fr 1.3fr; gap: 32px; }
  }
</style>
