---
import Logo from './ui/Logo.astro';
import Button from './ui/Button.astro';
import MobileNav from './MobileNav.astro';
import { site } from '../data/site';
import { url } from '../lib/url';

interface Props {
  /** true = transparent peste hero; false = fundal solid de la inceput */
  overlay?: boolean;
}

const { overlay = false } = Astro.props;

// Pagina curenta, fara `base`, ca sa marcam linkul activ.
const here = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '').replace(/\/$/, '') || '/';
---

<header data-header data-overlay={String(overlay)}>
  <div class="container h-full flex items-center justify-between gap-6">
    <a href={url('/')} aria-label="LOX Mobila, acasă" class="shrink-0">
      <Logo height={34} />
    </a>

    <nav aria-label="Principal" class="hidden xl:flex items-center gap-6 2xl:gap-8">
      {
        site.nav.map((item) => (
          <a
            href={url(item.href)}
            class="nav-link"
            aria-current={here === item.href ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2 sm:gap-5 shrink-0">
      <a href={site.phoneHref} class="nav-link hidden md:block">
        {site.phoneDisplay}
      </a>

      <!-- Sub 768px numarul ramane in bara, ca iconita de 44px. -->
      <a href={site.phoneHref} class="header__call" aria-label={`Sună: ${site.phoneDisplay}`}>
        <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M6.6 3.5h3l1.5 4.2-2 1.3a11 11 0 0 0 5.9 5.9l1.3-2 4.2 1.5v3a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4.6 5.7a2 2 0 0 1 2-2.2Z"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linejoin="round"
          />
        </svg>
      </a>

      <Button href={url('/contact')} class="text-[0.95rem] max-[389px]:!px-4">
        Cere ofertă
      </Button>

      <button
        type="button"
        class="xl:hidden grid place-items-center w-11 h-11 -mr-2"
        aria-controls="mobile-nav"
        aria-expanded="false"
        aria-label="Deschide meniul"
      >
        <span class="burger" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<MobileNav />

<style>
  [data-header] {
    position: fixed;
    inset: 0 0 auto;
    height: var(--header-h);
    z-index: 40;
    border-bottom: 1px solid transparent;
    transition:
      background-color var(--dur) var(--ease),
      border-color var(--dur) var(--ease);
  }

  /* Transparent peste hero; cu fundal, blur si o linie fina cand pagina a pornit la vale. */
  [data-header][data-overlay='false'],
  [data-header].is-scrolled {
    background: rgb(12 12 12 / 0.78);
    backdrop-filter: blur(14px) saturate(1.2);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    border-bottom-color: rgb(255 255 255 / 0.06);
  }

  .nav-link {
    position: relative;
    white-space: nowrap;
    font-size: 0.95rem;
    color: rgb(242 239 234 / 0.78);
    transition: color var(--dur) var(--ease);
  }

  .nav-link:hover,
  .nav-link:focus-visible,
  .nav-link[aria-current='page'] { color: var(--color-bone); }

  /* Aceeasi subliniere pentru hover, focus si pagina curenta; la hover creste din stanga. */
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -8px;
    height: 1px;
    background: var(--color-brass);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur) var(--ease);
  }

  .nav-link:hover::after,
  .nav-link:focus-visible::after,
  .nav-link[aria-current='page']::after { transform: scaleX(1); }

  .header__call {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 8px;
    color: var(--color-bone);
    transition: color var(--dur) var(--ease);
  }

  .header__call:hover,
  .header__call:focus-visible { color: var(--color-brass); }

  @media (min-width: 768px) {
    .header__call { display: none; }
  }

  .burger,
  .burger::before,
  .burger::after {
    display: block;
    width: 20px;
    height: 1.5px;
    background: var(--color-bone);
    transition: transform var(--dur) var(--ease);
  }

  .burger::before,
  .burger::after {
    content: '';
    position: absolute;
  }

  .burger::before { transform: translateY(-6px); }
  .burger::after { transform: translateY(6px); }
</style>
