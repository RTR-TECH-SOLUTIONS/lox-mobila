---
import Logo from './ui/Logo.astro';
import Button from './ui/Button.astro';
import MobileNav from './MobileNav.astro';
import { site } from '../data/site';
import { url } from '../lib/url';

interface Props {
  /** true = transparent peste hero; false = fundal solid de la inceput */
  overlay?: boolean;
}

const { overlay = false } = Astro.props;

// Pagina curenta, fara `base`, ca sa marcam linkul activ.
const here = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '').replace(/\/$/, '') || '/';
---

<header data-header data-overlay={String(overlay)}>
  <div class="container h-full flex items-center justify-between gap-6">
    <a href={url('/')} aria-label="LOX Mobila, acasă" class="shrink-0">
      <Logo height={34} />
    </a>

    <nav aria-label="Principal" class="hidden xl:flex items-center gap-6 2xl:gap-8">
      {
        site.nav.map((item) => (
          <a
            href={url(item.href)}
            class="nav-link"
            aria-current={here === item.href ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3 sm:gap-5 shrink-0">
      <a
        href={site.phoneHref}
        class="hidden sm:block text-[0.95rem] hover:text-brass transition-colors duration-200"
      >
        {site.phoneDisplay}
      </a>

      <Button href={url('/contact')} class="!h-11 !px-5 text-[0.95rem] xl:!h-13 xl:!px-7">
        Cere ofertă
      </Button>

      <button
        type="button"
        class="xl:hidden grid place-items-center w-11 h-11 -mr-2"
        aria-controls="mobile-nav"
        aria-expanded="false"
        aria-label="Deschide meniul"
      >
        <span class="burger" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<MobileNav />

<style>
  [data-header] {
    position: fixed;
    inset: 0 0 auto;
    height: var(--header-h);
    z-index: 40;
    border-bottom: 1px solid transparent;
    transition:
      background-color var(--dur) var(--ease),
      border-color var(--dur) var(--ease);
  }

  [data-header][data-overlay='false'],
  [data-header].is-scrolled {
    background: color-mix(in srgb, var(--color-ink) 92%, transparent);
    backdrop-filter: blur(10px);
    border-bottom-color: var(--color-line);
  }

  .nav-link {
    position: relative;
    white-space: nowrap;
    font-size: 0.95rem;
    color: rgb(242 239 234 / 0.78);
    transition: color var(--dur) var(--ease);
  }

  .nav-link:hover,
  .nav-link[aria-current='page'] { color: var(--color-bone); }

  .nav-link[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -8px;
    height: 1px;
    background: var(--color-brass);
  }

  .burger,
  .burger::before,
  .burger::after {
    display: block;
    width: 20px;
    height: 1.5px;
    background: var(--color-bone);
    transition: transform var(--dur) var(--ease);
  }

  .burger::before,
  .burger::after {
    content: '';
    position: absolute;
  }

  .burger::before { transform: translateY(-6px); }
  .burger::after { transform: translateY(6px); }
</style>
