---
/**
 * Galeria pe ecran complet. Controalele sunt desenate ca linii fine, in acelasi
 * limbaj cu releveul din hero: fara cercuri, fara umplere, fara pictograme rotunde.
 */
---

<dialog id="lightbox" aria-label="Galerie proiect">
  <div class="lb">
    <header class="lb__bar container">
      <span class="label" data-lb-counter></span>
      <button type="button" class="lb__icon lb__close" data-lb-close aria-label="Închide galeria">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M5 5 19 19M19 5 5 19" />
        </svg>
      </button>
    </header>

    <figure class="lb__stage">
      <button type="button" class="lb__icon lb__nav lb__nav--prev" data-lb-prev aria-label="Proiectul anterior">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M15 4 7 12l8 8" />
        </svg>
      </button>

      <img data-lb-img alt="" />

      <button type="button" class="lb__icon lb__nav lb__nav--next" data-lb-next aria-label="Proiectul următor">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M9 4l8 8-8 8" />
        </svg>
      </button>
    </figure>
  </div>
</dialog>

<style>
  #lightbox {
    width: 100%;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-bone);
  }

  #lightbox::backdrop { background: rgb(12 12 12 / 0.95); }

  .lb {
    display: grid;
    grid-template-rows: auto 1fr;
    height: 100%;
    padding-block: 18px 28px;
  }

  .lb__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 48px;
  }

  .lb__stage {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 0;
    margin: 0;
    padding: 12px clamp(56px, 8vw, 104px);
  }

  .lb__stage img {
    max-width: 100%;
    max-height: calc(100svh - 150px);
    width: auto;
    object-fit: contain;
    border-radius: var(--radius-img);
  }

  /* ---------- Controale ---------- */
  .lb__icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    color: var(--color-bone-2);
    transition: color var(--dur) var(--ease);
  }

  .lb__icon svg {
    width: 26px;
    height: 26px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: square;
  }

  .lb__icon:hover { color: var(--color-brass); }

  .lb__nav {
    position: absolute;
    top: 50%;
    translate: 0 -50%;
    width: clamp(48px, 7vw, 72px);
    height: 84px;
  }

  .lb__nav--prev { left: 0; }
  .lb__nav--next { right: 0; }

  .lb__nav svg { width: 32px; height: 32px; }

  .lb__close svg { stroke-width: 1.3; }

  @media (max-width: 599px) {
    .lb__stage { padding-inline: 44px; }
    .lb__nav { width: 44px; height: 64px; }
    .lb__nav svg { width: 24px; height: 24px; }
  }
</style>
