---
import Logo from './ui/Logo.astro';
import { site } from '../data/site';
import { categoryPages } from '../data/categories';
import { processSteps } from '../data/process';
import { url } from '../lib/url';

const year = new Date().getFullYear();

const contact = [
  { href: site.phoneHref, text: site.phoneDisplay, icon: 'M6 3h3l1.5 4-2 1.5a11 11 0 0 0 5 5l1.5-2 4 1.5v3a2 2 0 0 1-2 2A15 15 0 0 1 4 5a2 2 0 0 1 2-2Z' },
  { href: `mailto:${site.email}`, text: site.email, icon: 'M3 6h18v12H3V6Zm0 0 9 7 9-7' },
  { href: site.mapsUrl, text: site.address, icon: 'M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11Zm0-8.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z' },
];
---

<footer class="footer">
  <div class="wrap footer__inner">
    <div class="footer__grid">
      <div class="footer__brand">
        <Logo height={40} />
        <p>
          Mobilă la comandă din atelierul nostru din {site.city}: bucătării, dressinguri și
          mobilier pe măsura casei tale.
        </p>
        <ul class="footer__social">
          {
            site.social.map((s) => (
              <li><a href={s.href} class="footer__link">{s.label}</a></li>
            ))
          }
        </ul>
      </div>

      <nav aria-labelledby="f-cat">
        <h2 id="f-cat" class="footer__h">Categorii mobilier</h2>
        <ul class="footer__list">
          {categoryPages.map((c) => <li><a href={url(`/mobilier/${c.key}`)} class="footer__link">{c.label}</a></li>)}
        </ul>
      </nav>

      <nav aria-labelledby="f-srv">
        <h2 id="f-srv" class="footer__h">Servicii</h2>
        <ul class="footer__list">
          {processSteps.map((s) => <li><a href={url('/servicii')} class="footer__link">{s.title}</a></li>)}
          <li><a href={url('/materiale')} class="footer__link">Materiale</a></li>
        </ul>
      </nav>

      <div>
        <h2 class="footer__h">Contact</h2>
        <ul class="footer__list">
          {
            contact.map((c) => (
              <li>
                <a href={c.href} class="footer__link footer__contact">
                  <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
                    <path d={c.icon} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
                  </svg>
                  {c.text}
                </a>
              </li>
            ))
          }
        </ul>
        <dl class="footer__hours">
          {
            site.hours.map((h) => (
              <div>
                <dt>{h.days}</dt>
                <dd>{h.time}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>

    <p class="footer__legal">&copy; {year} {site.name}. Toate drepturile rezervate.</p>
  </div>
</footer>

<style>
  .footer { background: var(--color-deep); }

  .footer__inner { padding-block: 56px 28px; }

  .footer__grid {
    display: grid;
    gap: 40px;
  }

  .footer__brand { display: grid; gap: 18px; align-content: start; justify-items: start; }
  .footer__brand p { max-width: 34ch; color: var(--text-2); font-size: 0.9rem; }

  .footer__h {
    margin-bottom: 12px;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
  }

  .footer__list { display: grid; align-content: start; }

  .footer__link {
    display: inline-flex;
    align-items: center;
    min-height: 34px;
    color: var(--text-2);
    font-size: 0.9rem;
    transition: color var(--dur) var(--ease);
  }

  .footer__link:hover,
  .footer__link:focus-visible { color: var(--accent); }

  .footer__contact { gap: 10px; color: var(--text-body); }
  .footer__contact svg { flex: none; color: var(--color-brass); }

  .footer__social { display: flex; gap: 20px; }

  .footer__hours { display: grid; gap: 2px; margin-top: 12px; font-size: 0.9rem; }

  .footer__hours div { display: flex; justify-content: space-between; gap: 16px; max-width: 300px; }
  .footer__hours dt { color: var(--text-2); }

  .footer__legal {
    margin-top: 48px;
    padding-top: 22px;
    border-top: 1px solid var(--rule);
    color: var(--text-2);
    font-size: 0.8rem;
  }

  @media (min-width: 640px) {
    .footer__grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (min-width: 1024px) {
    .footer__grid { grid-template-columns: 1.4fr 1fr 1fr 1.3fr; gap: 40px; }
  }
</style>
