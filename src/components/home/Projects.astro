---
import { Image } from 'astro:assets';
import Button from '../ui/Button.astro';
import { projects } from '../../data/projects';
import { CATEGORY_LABELS } from '../../data/types';
import { resolveImage } from '../../lib/images';
import { homeProjects } from '../../lib/catalog';
import { url } from '../../lib/url';

// Tab-uri pe categorii, ca la Mobili Design; prima categorie e deschisa din start.
const tabs = Object.entries(CATEGORY_LABELS).map(([key, label]) => ({ key, label }));
const first = tabs[0].key;
// Cate un rand plin pe categorie; restul sunt pe /proiecte.
const PER_TAB = 3;
const picked = tabs.flatMap((t) => homeProjects(projects, t.key, PER_TAB));
const items = picked.map((p) => ({ p, k: picked.filter((o) => o.category === p.category).indexOf(p) }));
---

<section class="prj" aria-labelledby="proiecte-title" data-project-grid>
  <div class="wrap">
    <h2 id="proiecte-title" class="prj__title">Proiectele noastre</h2>

    <div class="prj__tabs" role="group" aria-label="Filtrează proiectele">
      {
        tabs.map((t) => (
          <button type="button" class="prj__tab" data-filter={t.key} aria-pressed={t.key === first}>
            {t.label}
          </button>
        ))
      }
    </div>

    <ul class="prj__grid" data-filter-grid>
      {
        items.map(({ p, k }) => (
          <li class="prj__item" data-project data-category={p.category} hidden={p.category !== first} style={`--k: ${k}`}>
            <a href={url(`/proiect/${p.slug}`)} class="prj__media">
              <Image
                src={resolveImage('projects', p.photos[0])}
                alt={p.title}
                widths={[480, 800, 1200]}
                sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                loading="lazy"
              />
            </a>
            <p class="prj__cap"><a href={url(`/proiect/${p.slug}`)}>{p.title}</a></p>
          </li>
        ))
      }
    </ul>
    <p class="sr-only" data-filter-status aria-live="polite"></p>

    <div class="prj__more">
      <Button href={url('/mobilier')} variant="outline">
        Vezi toate proiectele
        <svg class="arrow" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M2 7h10M8 3l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
      </Button>
    </div>
  </div>
</section>

<style>
  .prj {
    padding-block: var(--section-y);
    background: var(--color-ink-2);
  }

  .prj__title { text-align: center; }

  .prj__tabs {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 4px 24px;
    margin-block: 20px 28px;
  }

  .prj__tab {
    min-height: 44px;
    color: var(--text-2);
    font-size: 0.95rem;
    transition: color var(--dur) var(--ease);
  }

  .prj__tab:hover { color: var(--text); }

  .prj__tab[aria-pressed='true'] {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--color-brass);
    text-underline-offset: 8px;
  }

  .prj__grid {
    display: grid;
    gap: 28px 14px;
    transition: opacity 200ms var(--ease);
  }

  .prj__grid:global(.is-fading) { opacity: 0; }

  .prj__item:not([hidden]) { animation: rise 600ms var(--ease) both; animation-delay: calc(var(--k) * 90ms); }

  .prj__media {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--color-ink-3);
  }

  .prj__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms var(--ease);
  }

  .prj__media:hover :global(img) { transform: scale(1.03); }

  .prj__cap { margin-top: 10px; font-size: 0.95rem; }

  .prj__more {
    display: flex;
    justify-content: center;
    margin-top: 40px;
  }

  @media (min-width: 640px) {
    .prj__grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (min-width: 1024px) {
    .prj__grid { grid-template-columns: repeat(3, 1fr); }
  }

  @media (prefers-reduced-motion: reduce) {
    .prj__media:hover :global(img) { transform: none; }
  }
</style>
