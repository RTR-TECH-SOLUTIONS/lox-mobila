---
/** Nivelul de pret spus in cuvinte, relativ la celelalte materiale din tabel. */
interface Props {
  level: number;
}

const { level } = Astro.props;
const words = ['cel mai accesibil', 'mediu', 'peste mediu', 'cel mai scump'];
---

<span class="price">{words[level - 1]}</span>

<style>
  .price {
    font-size: var(--fs-label);
    color: var(--text-2);
    white-space: nowrap;
  }
</style>
